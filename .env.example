# 复制为 .env，填下面两项，然后执行 make up。
# 数据库口令和连接串都不在这里：库只发布在 127.0.0.1，口令固定在 compose.yaml，不用配。

# 聊天模型的密钥，自己申请。
REPO_EVIDENCE_MODEL_API_KEY=''

# 允许索引的本机代码仓库父目录。后端只读挂载它，且不会访问此目录之外的文件。
# 例如：/home/you/projects
REPO_EVIDENCE_ALLOWED_ROOT_PATH=''

# 若旧项目已占用默认端口，可取消注释并改成空闲端口；容器内部端口不变。
# REPO_EVIDENCE_POSTGRES_PORT=55433
# REPO_EVIDENCE_BACKEND_PORT=18000
# REPO_EVIDENCE_FRONTEND_PORT=15173

# 换模型改这两项，留空则用 backend/configs/local.toml 里的默认值
# （DeepSeek 的 https://api.deepseek.com 与 deepseek-v4-flash）。
# 任何 OpenAI 兼容的服务都可以，例如：
#   REPO_EVIDENCE_MODEL_BASE_URL='https://api.openai.com/v1'      REPO_EVIDENCE_MODEL_NAME='gpt-4.1-mini'
#   REPO_EVIDENCE_MODEL_BASE_URL='https://openrouter.ai/api/v1'   REPO_EVIDENCE_MODEL_NAME='anthropic/claude-sonnet-4'
#   REPO_EVIDENCE_MODEL_BASE_URL='http://127.0.0.1:11434/v1'      REPO_EVIDENCE_MODEL_NAME='qwen3:8b'
REPO_EVIDENCE_MODEL_BASE_URL=''
REPO_EVIDENCE_MODEL_NAME=''

# 本地嵌入服务的占位值，不是聊天模型密钥，保持原样即可。
OLLAMA_API_KEY=ollama

# 嵌入服务由 make up 自己起（容器内 Ollama + qwen3-embedding:0.6b），不用配。
# 只有要指向别处的 Ollama 时才填。换模型或地址后，应重新建立仓库索引。
# REPO_EVIDENCE_EMBEDDING_BASE_URL='http://host.docker.internal:11434/v1'
